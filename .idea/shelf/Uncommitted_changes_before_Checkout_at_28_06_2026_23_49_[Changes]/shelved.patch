new file mode 100644
--- /dev/null	(date 1782672364757)
+++ b/main.js	(date 1782672364757)
@@ -0,0 +1,129 @@
+// Ищем все кнопки открытия модалок
+const openButtons = document.querySelectorAll('.open-modal-btn');
+
+openButtons.forEach(btn => {
+    btn.addEventListener('click', () => {
+        const modalId = btn.getAttribute('data-modal');
+        const targetModal = document.getElementById(modalId);
+        if (targetModal) {
+            targetModal.style.display = 'flex'; // Показываем окно
+            document.body.style.overflow = 'hidden'; // Запрещаем скролл сайта на фоне
+        }
+    });
+});
+
+// Находим все кнопки закрытия и оверлеи, чтобы прятать окно обратно
+const modals = document.querySelectorAll('.portfolio-modal');
+modals.forEach(modal => {
+    const closeBtn = modal.querySelector('.modal-close-btn');
+    const overlay = modal.querySelector('.modal-overlay');
+
+    const closeModal = () => {
+        modal.style.display = 'none';
+        document.body.style.overflow = ''; // Возвращаем скролл сайту
+    };
+
+    if (closeBtn) closeBtn.addEventListener('click', closeModal);
+    if (overlay) overlay.addEventListener('click', closeModal); // Закрыть при клике мимо окна
+});
+<!-- Код скрипта вставляем сюда: -->
+
+const modal = document.getElementById("changelogModal");
+const openBtn = document.getElementById("openChangelogBtn");
+const closeBtn = document.getElementById("closeChangelogBtn");
+
+openBtn.onclick = function() {
+    modal.style.display = "block";
+}
+
+closeBtn.onclick = function() {
+    modal.style.display = "none";
+}
+
+window.onclick = function(event) {
+    if (event.target == modal) {
+        modal.style.display = "none";
+    }
+}
+// Функция для открытия нужного окна
+function openChangelog(id) {
+    var targetModal = document.getElementById(id);
+    if (targetModal) {
+        targetModal.style.display = "block";
+
+        // БЛОКИРУЕМ СКРОЛЛ САЙТА ПРИ ОТКРЫТИИ
+        document.body.classList.add('no-scroll');
+    }
+}
+
+// Функция для закрытия нужного окна
+function closeChangelog(id) {
+    var targetModal = document.getElementById(id);
+    if (targetModal) {
+        targetModal.style.display = "none";
+
+        // ВОЗВРАЩАЕМ СКРОЛЛ САЙТА ПРИ ЗАКРЫТИИ
+        document.body.classList.remove('no-scroll');
+    }
+}
+
+// Закрытие, если кликнули по темному фону вокруг окна
+window.onclick = function(event) {
+    if (event.target.classList.contains('modal')) {
+        event.target.style.display = "none";
+
+        // ТОЖЕ ВОЗВРАЩАЕМ СКРОЛЛ, ЕСЛИ КЛИКНУЛИ МИМО ОКНА
+        document.body.classList.remove('no-scroll');
+    }
+}
+
+// Ждем, пока вся страница загрузится
+document.addEventListener('DOMContentLoaded', () => {
+
+    // Находим элементы окна на странице
+    const emailBtn = document.getElementById('open-email-btn');
+    const emailModal = document.getElementById('email-modal');
+    const closeBtn = document.getElementById('close-email-btn');
+    const copyBtn = document.getElementById('copy-email-btn');
+    const emailText = document.getElementById('email-text');
+
+    // Защита: проверяем, что все элементы вообще есть на странице
+    if (emailBtn && emailModal && closeBtn && copyBtn && emailText) {
+
+        // 1. Открыть окно при клике на "Почта"
+        emailBtn.addEventListener('click', (e) => {
+            e.preventDefault(); // Предотвращаем переход по ссылке, если кнопка была ссылкой
+            emailModal.classList.add('active');
+        });
+
+        // 2. Закрыть окно при клике на крестик
+        closeBtn.addEventListener('click', () => {
+            emailModal.classList.remove('active');
+        });
+
+        // 3. Закрыть окно при клике на серый фон вокруг окошка
+        emailModal.addEventListener('click', (e) => {
+            if (e.target === emailModal) {
+                emailModal.classList.remove('active');
+            }
+        });
+
+        // 4. Логика кнопки "Скопировать"
+        copyBtn.addEventListener('click', () => {
+            navigator.clipboard.writeText(emailText.textContent.trim()).then(() => {
+                // Меняем текст кнопки для обратной связи
+                const originalText = copyBtn.textContent;
+                copyBtn.textContent = 'Скопировано!';
+                copyBtn.style.background = '#2ed573'; // Зеленый цвет успеха
+
+                // Через 2 секунды возвращаем всё как было
+                setTimeout(() => {
+                    copyBtn.textContent = originalText;
+                    copyBtn.style.background = ''; // Возвращает исходный цвет из CSS
+                }, 2000);
+            }).catch(err => {
+                console.error('Не удалось скопировать: ', err);
+            });
+        });
+    }
+});
